# GEMINI_API_KEY: Required for Gemma / Gemini API inference via Google AI Studio
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Model configuration (fallback order: gemma-4-26b-a4b-it, gemini-3.1-flash-lite-preview, gemini-flash-latest)
GEMMA_MODEL_NAME="gemma-4-26b-a4b-it"

# App settings
PORT=3000
SECRET_KEY="publicrss-secret-key-change-in-production"
DATABASE_URL="sqlite:///publicrss.db"
